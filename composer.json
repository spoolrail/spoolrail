{
    "name": "spoolrail/spoolrail",
    "description": "Message broker library made native to Laravel for building resilient distributed systems",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Diachenko"
        }
    ],
    "require": {
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "php": "^8.4",
        "illuminate/cache": "^12.0||^13.0",
        "illuminate/console": "^12.0||^13.0",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/queue": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "nesbot/carbon": "^3.0",
        "ramsey/uuid": "^4.7",
        "symfony/process": "^7.2||^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "rector/rector": "^2.3",
        "larastan/larastan": "^3.10",
        "driftingly/rector-laravel": "^2.1",
        "php-amqplib/php-amqplib": "^3.7.4"
    },
    "autoload": {
        "psr-4": {
            "Spoolrail\\Spoolrail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spoolrail\\Spoolrail\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Spoolrail\\Spoolrail\\SpoolrailServiceProvider"
            ]
        }
    },
    "suggest": {
        "php-amqplib/php-amqplib": "Required to use the RabbitMQ driver (^3.7.4)."
    },
    "scripts": {
        "test": "pest --compact --parallel",
        "format": [
            "pint --parallel",
            "npm run format"
        ],
        "format:check": [
            "pint --test --parallel",
            "npm run format:check"
        ],
        "analyse": "phpstan --memory-limit=1G",
        "refactor": "rector",
        "mutate": [
            "Composer\\Config::disableProcessTimeout",
            "pest --mutate --everything --covered-only"
        ],
        "mutate:herd": [
            "Composer\\Config::disableProcessTimeout",
            "herd coverage ./vendor/bin/pest --mutate --everything --covered-only"
        ],
        "coverage": "pest --coverage",
        "coverage:herd": "herd coverage ./vendor/bin/pest --coverage"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
