<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         defaultTestSuite="Default"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="random"
         failOnWarning="true"
         failOnRisky="true"
         failOnEmptyTestSuite="false"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="Default">
            <directory>tests/Feature</directory>
            <directory>tests/Unit</directory>
            <file>tests/ArchTest.php</file>
        </testsuite>
        <testsuite name="External">
            <directory>tests/External</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Arch">
            <file>tests/ArchTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </source>
    <php>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="testing"/>
        <env name="SPOOLRAIL_CONNECTION" value="array"/>
        <env name="SPOOLRAIL_PREFIX" value="spoolrail-tests"/>
        <env name="RABBITMQ_USERNAME" value="spoolrail"/>
        <env name="RABBITMQ_PASSWORD" value="spoolrail"/>
        <env name="RABBITMQ_VHOST" value="spoolrail"/>
    </php>
</phpunit>
